# 발행 API 토큰 (autostudio 발행 클라이언트가 X-Authorization: Bearer {token} 사용)
BLOG_TOKEN=
# GA4 Measurement ID (G-XXXXXXX)
GA4_MEASUREMENT_ID=
# 공개 base URL (OG·canonical 절대 URL — 도메인 확정 후 변경)
BLOG_BASE_URL=http://localhost:8000
# 프로덕션 Supabase(B) — Transaction pooler (포트 6543)
# DATABASE_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///data/blog.db
# ENV=production이면 BLOG_TOKEN 필수
ENV=development
# 발행 API CORS 허용 origin (콤마 구분) — autostudio의 Vercel/로컬 주소
CORS_ORIGINS=http://localhost:5173
